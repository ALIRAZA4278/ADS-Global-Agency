# Copy to .env.local for local development, and set the same keys in your
# host's environment settings for production. Never commit the real values.

# --- Outgoing mail (Hostinger SMTP) ------------------------------------------
# The website sends form submissions through one of your Hostinger mailboxes.
# Use the full mailbox address as the user and that mailbox's password.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@adsglobalagency.com
SMTP_PASS=

# Shown as the sender. Must be the SMTP_USER mailbox (or an alias of it),
# otherwise Hostinger rejects the message or it lands in spam.
MAIL_FROM="ADS Global Website <support@adsglobalagency.com>"

# --- Where submissions go ----------------------------------------------------
# Enquiry forms (hero + "Get a free quote" modal).
INQUIRY_TO=aussiedesignsolutions@gmail.com
# Careers application form (résumé attached).
CAREERS_TO=career@adsglobalagency.com
